DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jihc"
NEXTAUTH_URL="http://localhost:3000"  # продакшнда: https://my.jihc.edu.kz
# Caddy осы доменге HTTPS сертификатын алады (docker-compose.yml)
DOMAIN="my.jihc.edu.kz"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Google OAuth (Google Cloud Console → Credentials). Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAIL_DOMAIN="jihc.edu.kz"
# "true" — әр рөлге бір батырмамен кіру (тек демо/әзірлеу үшін, продакшнда өшіріңіз)
DEMO_LOGIN="false"
# Справкалар сақталатын жер (жергілікті диск). Продакшнда S3/Supabase-ке ауыстыруға болады: src/lib/storage.ts
UPLOAD_DIR="./uploads"
TZ="Asia/Almaty"
POSTGRES_PASSWORD="change-me"

# Колледждің ашық сайты (порталдағы «Басты бет» сілтемесі)
NEXT_PUBLIC_SITE_URL="https://jihc.edu.kz"
