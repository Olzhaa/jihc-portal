// JIHC Portal — Prisma schema (ТЗ 4-бөлімі негізінде, олқылықтары толықтырылған)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  VICE_PRINCIPAL
  DIRECTOR
  PARENT
  ADMIN // жүйе әкімшісі (IT): админ панельге толық қол жеткізу
}

enum CertificateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEFT_EARLY // ерте кетті (EduPage: «Ушел раньше»)
  EXCUSED
}

// Баға категориялары EduPage-тегі колледж бекіткен бағандармен сәйкес (src/lib/assessment.ts)
enum GradeType {
  CURRENT // Ағымдағы бағалар
  MIDTERM // Ағымдағы бақылау
  EXAM // Емтихан немесе сынақ
  ATTENDANCE // Сабаққа қатысуы
}

enum SyllabusStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ResourceType {
  CLASSROOM // кәдімгі кабинет: бос болса бірден расталады
  LAB // компьютер кабинеті
  STAFFROOM // мұғалімдер бөлмесі
  HALL // акт залы
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique // ата-аналарда корпоративтік пошта жоқ
  name      String
  role      Role
  iin       String?  @unique // ЖСН (студенттер үшін)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  active    Boolean  @default(true) // false: кете алмайды (бітірген студент, жұмыстан кеткен мұғалім), деректері сақталады
  createdAt DateTime @default(now())

  // Ата-ана ↔ бала байланысы (бір ата-анада бірнеше бала болуы мүмкін)
  children      ParentLink[] @relation("ParentLinks")
  parents       ParentLink[] @relation("ChildLinks")
  parentId      String?      @unique // жүйе берген Parent ID (тек PARENT рөлі үшін)
  parentPinHash String? // ата-ананың PIN хэші

  teachingSlots    Schedule[]           @relation("TeacherSchedule")
  attendance       Attendance[]         @relation("StudentAttendance")
  markedAttendance Attendance[]         @relation("MarkedBy")
  grades           Grade[]              @relation("StudentGrades")
  givenGrades      Grade[]              @relation("GivenBy")
  assignments      Assignment[]
  certificates     MedicalCertificate[] @relation("StudentCertificates")
  reviewedCerts    MedicalCertificate[] @relation("CertReviewer")
  syllabi          Syllabus[]           @relation("SyllabusAuthor")
  reviewedSyllabi  Syllabus[]           @relation("SyllabusReviewer")
  bookings         Booking[]
  announcements    Announcement[]
  rules            Rule[]
  managedRooms     Room[]               @relation("RoomManager")

  // Куратор
  curatedGroups   Group[]         @relation("GroupCurator")
  studentProfile  StudentProfile?
  guardians       Guardian[]
  contactLogs     ContactLog[]    @relation("ContactStudent")
  writtenContacts ContactLog[]    @relation("ContactAuthor")
  achievements    Achievement[]
  books           BookRead[]
  testResults     TestResult[]
  reflections     Reflection[]

  auditLogs AuditLog[]
}

model ParentLink {
  parentId String
  childId  String
  parent   User   @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child    User   @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
}

model Group {
  id            String         @id @default(uuid())
  name          String         @unique // EduPage атауы, мысалы "2F-1"
  snationCode   String? // Smart Nation-дағы атауы, мысалы "F1-2025"
  curatorId     String? // топ кураторы (завуч тағайындайды)
  curator       User?          @relation("GroupCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  students      User[]
  schedule      Schedule[]
  announcements Announcement[] @relation("AnnouncementGroups")
  curatorTasks  CuratorTask[]
  classEvents   ClassEvent[]
  assignments   Assignment[]
}

model Course {
  id          String       @id @default(uuid())
  code        String? // модуль коды, мысалы "КМ4 ОН 4.1, 4.3"
  title       String
  color       String       @default("#93c5fd")
  schedule    Schedule[]
  grades      Grade[]
  assignments Assignment[]
  attendance  Attendance[]
  syllabi     Syllabus[]
}

model Room {
  id        String       @id @default(uuid())
  name      String       @unique // "304 Кабинет", "Акт залы"
  type      ResourceType
  capacity  Int?
  managerId String? // жауапты мұғалім: арнайы бөлмелердің өтінімдерін бекітеді
  manager   User?        @relation("RoomManager", fields: [managerId], references: [id])
  schedule  Schedule[]
  bookings  Booking[]
}

model Schedule {
  id          String @id @default(uuid())
  groupId     String
  courseId    String
  teacherId   String
  roomId      String
  dayOfWeek   Int // 1-5 (Дс–Жм)
  startPeriod Int // қоңырау нөмірі, 1-ден басталады (src/lib/bells.ts)
  endPeriod   Int // қоса алғанда; бір сабақ бірнеше қоңырауды алуы мүмкін

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User   @relation("TeacherSchedule", fields: [teacherId], references: [id])
  room    Room   @relation(fields: [roomId], references: [id])

  attendance Attendance[]
  grades     Grade[]
  records    LessonRecord[]

  @@index([groupId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
}

model Attendance {
  id         String           @id @default(uuid())
  studentId  String
  courseId   String
  scheduleId String?
  markedById String
  date       DateTime         @db.Date
  status     AttendanceStatus

  student  User      @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  course   Course    @relation(fields: [courseId], references: [id])
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  markedBy User      @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([studentId, scheduleId, date])
  @@index([courseId, date])
}

model Grade {
  id           String    @id @default(uuid())
  studentId    String
  courseId     String
  scheduleId   String?
  givenById    String
  type         GradeType @default(CURRENT)
  value        Float
  weight       Float     @default(1) // коэффициент: 0.25, 0.5, 1, 2, 3
  workType     String    @default("simple") // Smart Nation баға түрі (src/lib/assessment.ts)
  assignmentId String? // EduPage «Назначение/экзамен» бағаны; журналдан қойылған бағада бос
  comment      String?
  date         DateTime  @default(now())

  student    User        @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id])
  schedule   Schedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  givenBy    User        @relation("GivenBy", fields: [givenById], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([studentId, courseId])
}

/// EduPage «Новое назначение / экзамен»: бағалар кітабындағы бір баған (атауы, категориясы, коэффициенті, күні).
model Assignment {
  id          String    @id @default(uuid())
  courseId    String
  groupId     String
  createdById String
  title       String
  type        GradeType @default(CURRENT)
  weight      Float     @default(1)
  workType    String    @default("simple")
  date        DateTime  @db.Date
  createdAt   DateTime  @default(now())

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
  grades    Grade[]

  @@index([courseId, groupId])
}

// Сабақтың тақырыбы мен үй жұмысы (EduPage «Классный журнал», Smart Nation журнал күні)
model LessonRecord {
  id         String   @id @default(uuid())
  scheduleId String
  date       DateTime @db.Date
  topic      String?
  homework   String?
  updatedAt  DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
}

model Syllabus {
  id         String         @id @default(uuid())
  courseId   String
  authorId   String
  reviewerId String?
  title      String
  topics     Json // SyllabusTopic[] (src/lib/syllabus.ts): ОН → тақырып → сағаттар
  details    Json? // SyllabusDetails: титул, түсіндірме жазба, СӨЖ тапсырмалары, әдебиеттер
  totalHours Int
  status     SyllabusStatus @default(DRAFT)
  reviewNote String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  course   Course @relation(fields: [courseId], references: [id])
  author   User   @relation("SyllabusAuthor", fields: [authorId], references: [id])
  reviewer User?  @relation("SyllabusReviewer", fields: [reviewerId], references: [id])
}

model Booking {
  id        String        @id @default(uuid())
  roomId    String
  userId    String
  startTime DateTime
  endTime   DateTime
  reason    String
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([roomId, startTime])
}

model MedicalCertificate {
  id         String            @id @default(uuid())
  studentId  String
  reviewerId String?
  fileUrl    String
  startDate  DateTime          @db.Date
  endDate    DateTime          @db.Date
  status     CertificateStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime          @default(now())

  student  User  @relation("StudentCertificates", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer User? @relation("CertReviewer", fields: [reviewerId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  important Boolean  @default(false)
  createdAt DateTime @default(now())

  author User    @relation(fields: [authorId], references: [id])
  groups Group[] @relation("AnnouncementGroups") // бос болса — барлығына
}

model Rule {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
}

// --- Куратор жұмыс кеңістігі (src/lib/curator.ts өрістерімен сәйкес) ---
// Таңдау өрістері қазақша мәтін ретінде сақталады; тізімдер src/lib/curator.ts ішінде.

model StudentProfile {
  studentId        String    @id
  birthDate        DateTime? @db.Date
  gender           String?
  phone            String?
  city             String?
  address          String?
  siblings         String?
  activity         String? // Белсенді | Орташа | Тұйық — назар керек
  club             String?
  hobbies          String[]
  strongSubjects   String?
  weakSubjects     String?
  goal             String?
  psychNote        String? // қысқа түйін ғана
  mbti             String?
  gallup           String[] // Top-5
  gardner          String[]
  designDirection  String?
  futurePlan       String?
  targetUniversity String?
  targetSpecialty  String?
  studyCountries   String[]
  admissionStatus  String?
  ieltsScore       Float?
  ieltsDate        DateTime? @db.Date
  portfolioUrl     String?
  practicePlace    String?
  alumniNow        String?
  socialStatus     String?
  parentConsent    Boolean   @default(false)
  homeVisited      Boolean   @default(false)
  homeVisitDate    DateTime? @db.Date
  note             String?
  updatedAt        DateTime  @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Куратордың ата-ана туралы жазбасы (порталға кіретін PARENT аккаунтынан бөлек)
model Guardian {
  id             String  @id @default(uuid())
  studentId      String
  name           String
  relation       String?
  phone          String?
  phone2         String?
  email          String?
  workplace      String?
  position       String?
  familyStatus   String?
  responsiveness String?
  note           String?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// Байланыс журналы: студентпен немесе ата-анамен әр сөйлесу
model ContactLog {
  id            String    @id @default(uuid())
  studentId     String
  authorId      String
  date          DateTime  @db.Date
  withWhom      String // Студент | Ата-ана | Студент + ата-ана
  summary       String
  topics        String[]
  mood          String?
  durationMin   Float?
  discussed     String?
  agreedStep    String?
  followUpDate  DateTime? @db.Date
  agreementDone Boolean   @default(false)
  notifyParent  Boolean   @default(false)
  createdAt     DateTime  @default(now())

  student User @relation("ContactStudent", fields: [studentId], references: [id], onDelete: Cascade)
  author  User @relation("ContactAuthor", fields: [authorId], references: [id])

  @@index([studentId, date])
}

// Куратор циклы: топтың қайталанатын міндеттері
model CuratorTask {
  id        String    @id @default(uuid())
  groupId   String
  title     String
  frequency String
  course    String? // бос болса — барлық курсқа ортақ
  logIn     String?
  source    String?
  nextDue   DateTime? @db.Date
  done      Boolean   @default(false)
  order     Int       @default(0)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// Іс-шаралар мен тәрбие сағаттары
model ClassEvent {
  id               String    @id @default(uuid())
  groupId          String
  title            String
  type             String?
  format           String?
  date             DateTime? @db.Date
  place            String?
  status           String
  budget           Float?
  directions       String[]
  responsibleIds   String[] // жауапты студенттердің id-лері
  goal             String?
  considerations   String?
  expectedResult   String?
  analysis         String?
  feedback         String?
  parentPermission Boolean   @default(false)
  parentsAttend    Boolean   @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, date])
}

model Achievement {
  id             String    @id @default(uuid())
  studentId      String
  title          String
  type           String?
  level          String?
  result         String?
  date           DateTime? @db.Date
  parentNotified Boolean   @default(false)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model BookRead {
  id         String    @id @default(uuid())
  studentId  String
  title      String
  author     String?
  status     String
  language   String?
  genres     String[]
  pages      Float?
  rating     String?
  startedAt  DateTime? @db.Date
  finishedAt DateTime? @db.Date
  review     String?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// Психологиялық және кәсіби тесттер. «Тек психолог» болса нәтиже сақталмайды.
model TestResult {
  id          String    @id @default(uuid())
  studentId   String
  test        String
  date        DateTime? @db.Date
  conductedBy String?
  privacy     String
  result      String?
  discussed   Boolean   @default(false)
  agreedStep  String?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// Студенттің семестрлік өзін-өзі бағалауы (студент өзі толтырады)
model Reflection {
  id              String   @id @default(uuid())
  studentId       String
  semester        String
  pride           String
  difficulty      String?
  helpNeeded      String?
  nextGoal        String?
  diligence       String
  responsibility  String
  selfDevelopment String
  designInterest  String?
  createdAt       DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// Админ панельдегі әр өзгеріс: кім, қашан, нені өзгертті
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // CREATE | UPDATE | DELETE | IMPORT
  entity    String // src/lib/admin/entities.ts кілті, мысалы "users"
  recordId  String?
  summary   String // адамға түсінікті сипаттама
  changes   Json? // { өріс: [бұрынғы, жаңа] }
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, recordId])
}
